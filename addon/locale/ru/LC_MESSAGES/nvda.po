#. Translators: message presented in input mode.
#: addon\appModules\perky.py:79
msgid "Shows the selected text converted to braille using symbols for the current language"
msgstr "Показывает выделенный текст, преобразованный в Брайль с использованием символов текущего языка"

#. Translators: The message reported when there is no selection
#: addon\appModules\perky.py:89 addon\appModules\perky.py:115
msgid "No selection"
msgstr "Нет выделения"

#. Translators: title of NVDA message showing text converted to braille.
#: addon\appModules\perky.py:96
#, python-brace-format
msgid "Text converted to braille symbols ({languageDescription})"
msgstr "Текст преобразован в брайлевские символы ({languageDescription})"

#. Translators: message presented in input mode.
#: addon\appModules\perky.py:105
msgid "Shows the selected text in browse mode"
msgstr "Показывает выделенный текст в режиме обзора"

#. Translators: Title for a message dialog showing raw selected text.
#: addon\appModules\perky.py:121
msgid "Raw selected text"
msgstr "Выделен необработанный текст"

